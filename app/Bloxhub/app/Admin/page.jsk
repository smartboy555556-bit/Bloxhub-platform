```jsx
'use client';
import { useState, useEffect } from 'react';
import { supabase } from '@/lib/supabase';

export default function AdminPage() {
  const [adminId, setAdminId] = useState(null);
  const [users, setUsers] = useState([]);
  const [authorized, setAuthorized] = useState(false);

  useEffect(() => {
    supabase.auth.getSession().then(async ({ data: { session } }) => {
      if (!session?.user) return;
      const { data: me } = await supabase.from('profiles').select('role').eq('id', session.user.id).single();
      if (me?.role === 'admin') {
        setAuthorized(true);
        setAdminId(session.user.id);
        const { data: allUsers } = await supabase.from('profiles').select('*').order('created_at', { ascending: false });
        setUsers(allUsers || []);
      }
    });
  }, []);

  const handleSave = async (targetUserId) => {
    const newCoins = document.getElementById(`coins-${targetUserId}`).value;
    const newPrice = document.getElementById(`price-${targetUserId}`).value;

    const res = await fetch('/api/admin/update-user', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        adminId,
        targetUserId,
        coin_balance: newCoins,
        coin_unit_price_ngn: newPrice
      })
    });

    if (res.ok) alert('Updated player successfully!');
    else alert('Failed to update player.');
  };

  if (!authorized) return <div className="p-10 text-white bg-slate-950 min-h-screen">Checking admin access...</div>;

  return (
    <div className="min-h-screen bg-slate-950 text-white p-6">
      <div className="max-w-5xl mx-auto">
        <div className="flex justify-between items-center mb-6">
          <h1 className="text-2xl font-bold">Admin Control Panel</h1>
          <a href="/" className="text-blue-400 underline">Back to Platform</a>
        </div>
        <div className="overflow-x-auto bg-slate-900 rounded-xl border border-slate-800">
          <table className="w-full text-left border-collapse">
            <thead>
              <tr className="border-b border-slate-800 text-slate-400 text-sm">
                <th className="p-4">Username</th>
                <th className="p-4">Referral Code</th>
                <th className="p-4">Coins Balance</th>
                <th className="p-4">Price Per Coin (₦)</th>
                <th className="p-4">Action</th>
              </tr>
            </thead>
            <tbody>
              {users.map((u) => (
                <tr key={u.id} className="border-b border-slate-800/60">
                  <td className="p-4 font-semibold">{u.username}</td>
                  <td className="p-4 text-slate-400">{u.referral_code}</td>
                  <td className="p-4">
                    <input id={`coins-${u.id}`} type="number" defaultValue={u.coin_balance} className="w-28 p-1.5 rounded bg-slate-800 border border-slate-700" />
                  </td>
                  <td className="p-4">
                    <input id={`price-${u.id}`} type="number" step="0.01" defaultValue={u.coin_unit_price_ngn} className="w-24 p-1.5 rounded bg-slate-800 border border-slate-700" />
                  </td>
                  <td className="p-4">
                    <button onClick={() => handleSave(u.id)} className="bg-blue-600 hover:bg-blue-500 px-4 py-1.5 rounded text-sm font-bold">Save</button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
}